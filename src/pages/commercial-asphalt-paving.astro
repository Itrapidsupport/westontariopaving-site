---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { tollFree } from '../data/site.js';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Commercial asphalt paving | West Ontario Paving" description="Commercial asphalt paving, resurfacing, striping and repair. New parking lots, grading and repairs built to handle daily traffic, from a family-owned Ontario contractor." path="commercial-asphalt-paving/" preload="roller" preloadSizes="(min-width: 900px) 45vw, 100vw" cta="trucks2" ld={[{ '@context': 'https://schema.org', '@type': 'Service', name: 'Commercial asphalt paving', serviceType: 'Asphalt paving, resurfacing, striping and repair', provider: { '@type': 'LocalBusiness', name: 'West Ontario Paving' }, areaServed: 'Ontario' }]}>
  <section class="phero">
    <div class="phero__txt">
      <p class="phero__crumb in-rise" style="--d:.05s"><a href={`${b}/`}>Home</a> / Commercial paving</p>
      <h1 class="phero__h"><span class="ln"><span class="in-word" style="--d:0.10s">Commercial</span></span><span class="ln"><span class="in-word" style="--d:0.18s">asphalt paving</span></span></h1>
      <p class="phero__lede in-rise" style="--d:.2s">Long-lasting, durable surfaces built to handle the daily traffic of your business.</p>
      <div class="hero__btns in-rise" style="--d:.25s">
        <a class="btn btn--red btn--lg mag" href={`${b}/request-a-quote/`}><span>Request a free quote</span></a>
        <a class="btn btn--line btn--lg mag" href={`tel:${tollFree.tel}`}><span>Call {tollFree.num}</span></a>
      </div>
    </div>
    <div class="phero__ph in-wipe" style="--d:.1s"><div class="px-hero"><Pic k="roller" eager sizes="(min-width: 900px) 45vw, 100vw" pos="50% 62%" /></div></div>
  </section>
  <section class="prose wrap">
    <div class="prose__copy">
      <p class="lead brighten">We understand the importance of a well-maintained, good-looking commercial property, and we’re here to make that happen for you.</p>
      <p class="fade">Our team uses top-of-the-line equipment and techniques to ensure that the job is done efficiently and effectively. From analyzing the site to completing the final touches, our team is dedicated to providing you with exceptional service every step of the way.</p>
      <p class="fade">We understand that time is precious, and our goal is to complete the job as quickly as possible, without compromising quality.</p>
      <p class="fade">Whether you need a new parking lot or driveway, or just need repairs to your existing pavement, our team is here to help, at a competitive price.</p>
      <a class="tlink fade" href={`${b}/request-a-quote/`}>Request a free quote</a>
    </div>
    <div class="prose__ph">
      <figure class="reveal"><div class="px"><Pic k="lot" eager sizes="(min-width: 1180px) 24vw, (min-width: 900px) 46vw, 46vw" pos="50% 65%" /></div></figure>
      <figure class="reveal"><div class="px"><Pic k="dump2" eager sizes="(min-width: 1180px) 24vw, (min-width: 900px) 46vw, 46vw" /></div></figure>
    </div>
  </section>
  <section class="band">
    <div class="wrap band__in">
      <div>
        <h2 class="rise-lines">Experienced in all aspects of commercial paving</h2>
        <figure class="reveal" style="margin-top:36px;aspect-ratio:4/3"><div class="px"><Pic k="tearup" sizes="(min-width: 900px) 44vw, 92vw" pos="40% 55%" /></div></figure>
      </div>
      <ul class="fade">
        <li>New pavement installation</li><li>Grading</li><li>Asphalt repair</li><li>Resurfacing</li><li>Striping</li>
      </ul>
    </div>
  </section>
</Base>
