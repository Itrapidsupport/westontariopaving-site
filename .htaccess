# BEGIN ITRS new site 2026-11-24 (West Ontario Paving static site)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Leave AutoSSL / ACME validation alone
RewriteRule ^\.well-known/ - [L]

# Force HTTPS + bare domain
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.westontariopaving\.com$ [NC]
RewriteRule ^(.*)$ https://westontariopaving.com/$1 [R=301,L]

# Old WordPress URLs -> new pages (keep Google ranking)
RewriteRule ^gallery-of-our-work/?$ /gallery/ [R=301,L]
RewriteRule ^contact-west-ontario-paving/?$ /request-a-quote/ [R=301,L]
RewriteRule ^residential-commercial-paving-services/?$ /residential-asphalt-paving/ [R=301,L]
RewriteRule ^(barrie|midhurst-springwater|wasaga-beach|the-blue-mountains|orillia|oakville|mississauga|midland|gravenhurst|etobicoke|collingwood|burlington|brampton|innisfil)-ontario-paving/?$ / [R=301,L]
RewriteRule ^oro-medonte-paving/?$ / [R=301,L]
RewriteRule ^locations/?$ / [R=301,L]
RewriteRule ^paul-roger/?$ / [R=301,L]
RewriteRule ^dipl-team-member/ / [R=301,L]
RewriteRule ^author/ / [R=301,L]
# Nested junk URLs seen in the crawl, e.g. /request-a-quote/innisfil-ontario-paving/
RewriteRule ^(request-a-quote|gallery-of-our-work|contact-west-ontario-paving|commercial-asphalt-paving|residential-asphalt-paving)/[a-z-]+-ontario-paving/?$ / [R=301,L]
# Old feeds / sitemaps
RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]
RewriteRule ^(wp-sitemap|sitemap_index|sitemap)\.xml$ / [R=302,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType image/avif .avif
AddType font/woff2 .woff2
# END ITRS new site
